#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR" || exit

for script in ./scripts/install.sh ./scripts/package.sh ./scripts/run.sh; do
    [[ -f "$script" ]] || { echo "Missing required script: $script" >&2; exit 1; }
    [[ -x "$script" ]] || chmod +x "$script"
done

case "${1:-}" in
    install)
        shift
        exec "./scripts/install.sh" "$@"
        ;;

    package)
        shift
        exec "./scripts/package.sh" "$@"
        ;;

    *)
        exec "./scripts/run.sh" "$@"
        ;;
esac
